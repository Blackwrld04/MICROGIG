# =============================================================================
# microgig — ALL credentials for every service, in one file.
#
#   1. Copy this file to `.env` in the repo root (same folder as this file).
#   2. Fill in the values. `.env` is git-ignored: never commit real secrets.
#   3. Hosting: copy each section into that platform's dashboard.
#        - [WEB]  → Vercel project (Root Directory: apps/web) → Settings → Environment Variables
#        - [API]  → Render / Railway service (root: apps/api)   → Environment
#
# Rules:
#   - Anything starting with NEXT_PUBLIC_ is sent to the browser. NEVER put a secret in one.
#   - Secrets (passwords, keys, tokens) belong to [API] only. The web app never needs them.
#   - Generate secrets with:  openssl rand -hex 64
# =============================================================================


# =============================================================================
# [WEB] Frontend — apps/web (Vercel)
# =============================================================================

# Public URL of the frontend (used for links and metadata).
# Local: http://localhost:3000   Vercel: https://<your-project>.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo mode: "true" = use built-in sample data and demo sign-in (no backend needed).
#            "false" = talk to the real backend at API_URL.
NEXT_PUBLIC_USE_MOCKS="true"

# Base URL of the backend (server-side only, never exposed to the browser).
# The frontend proxies /api/v1/* to this URL, so auth cookies stay on the frontend domain.
# Required when NEXT_PUBLIC_USE_MOCKS="false".
# Local: http://localhost:4000   Render: https://microgig-api.onrender.com
API_URL=""

# Public base URL of the gig-image bucket (S3/R2 public bucket or its CDN), used by next/image.
# Example: https://pub-xxxxxxxx.r2.dev   or   https://microgig-showcase-public.s3.amazonaws.com
NEXT_PUBLIC_ASSETS_URL=""


# =============================================================================
# [API] Backend — apps/api (Render or Railway)
# =============================================================================

NODE_ENV="development"
PORT=4000

# Public URL of the frontend. Used for email links and as the allowed CORS origin
# (the browser normally reaches the API through the frontend proxy, so CORS is a fallback).
WEB_ORIGIN="http://localhost:3000"

# ---- PostgreSQL (Supabase / Neon / local Docker) ----------------------------
# Pooled connection for the app (add ?pgbouncer=true for Supabase/Neon poolers).
DATABASE_URL=""
# Direct (non-pooled) connection, used by Prisma migrations.
DIRECT_URL=""

# ---- Redis (BullMQ queues + 10-minute reconciler) ---------------------------
# Local: redis://:redis_secure_pass@localhost:6379
REDIS_URL=""

# ---- Upstash Redis REST (rate limiting, PRD §13.2) ---------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- Auth & sessions (PRD §13.1) ---------------------------------------------
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
COOKIE_SECRET=""

# ---- Object storage: AWS S3 / Cloudflare R2 / local MinIO --------------------
# Local MinIO: endpoint http://localhost:9000, keys minioadmin / minioadmin
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BUCKET_NAME="microgig-showcase-public"
S3_PRIVATE_BUCKET_NAME="microgig-deliverables-private"

# ---- Transactional email (Resend API or Gmail / SMTP) ------------------------
# OPTION 1: Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="MicroGig <onboarding@resend.dev>"

# OPTION 2: Gmail SMTP (No custom domain required - send from your Gmail!)
# Generate 16-character App Password at: https://myaccount.google.com/apppasswords
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="true"

# ---- Business constants (PRD Appendix A) -------------------------------------
PLATFORM_FEE_BPS=2000
AUTO_COMPLETE_DELAY_HOURS=72
REVISION_DEADLINE_HOURS=24
CLEARING_PERIOD_DAYS=3
SKIP_CLEARING_PERIOD="false"

# ---- Feature flags ------------------------------------------------------------
ENABLE_DISINTERMEDIATION_WARNING="true"
ENABLE_CLAMAV_SCAN="false"
